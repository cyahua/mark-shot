include_guard(GLOBAL)

option(MARK_SHOT_RELEASE_SECTION_GC "Drop unreferenced functions and data from Release binaries" ON)
option(MARK_SHOT_RELEASE_LTO "Enable interprocedural optimization for shipping builds" ON)
option(MARK_SHOT_RELEASE_COMPACT_UI "Optimize cold UI/configuration code for size" ON)
set(_release_configs "$<CONFIG:Release,MinSizeRel,RelWithDebInfo>")

if(MARK_SHOT_RELEASE_SECTION_GC)
    if(MSVC)
        add_compile_options("$<${_release_configs}:/Gy;/Gw>")
        add_link_options("$<${_release_configs}:/OPT:REF;/OPT:ICF;/INCREMENTAL:NO>")
    elseif(CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang")
        add_compile_options("$<${_release_configs}:-ffunction-sections;-fdata-sections>")
        if(APPLE)
            add_link_options("$<${_release_configs}:LINKER:-dead_strip>")
        else()
            add_link_options("$<${_release_configs}:LINKER:--gc-sections>")
            # 【构建】【发行体积】Rust 标准库归档也可能携带调试段，发行链接时统一移除
            add_link_options("$<$<CONFIG:Release,MinSizeRel>:LINKER:--strip-debug>")
        endif()
    endif()
endif()

if(MARK_SHOT_RELEASE_LTO)
    include(CheckIPOSupported)
    check_ipo_supported(RESULT _lto_supported OUTPUT _lto_error LANGUAGES C CXX)
    if(_lto_supported)
        set(CMAKE_INTERPROCEDURAL_OPTIMIZATION_RELEASE ON)
        set(CMAKE_INTERPROCEDURAL_OPTIMIZATION_MINSIZEREL ON)
    else()
        message(STATUS "mark-shot: LTO unavailable for this toolchain: ${_lto_error}")
    endif()
endif()

# 为 ARGN 中的冷路径源文件追加体积优化；像素处理、缩放、录制和 Rust 核心保留速度策略
function(mark_shot_optimize_cold_sources)
    if(NOT MARK_SHOT_RELEASE_COMPACT_UI)
        return()
    endif()
    if(MSVC)
        set(_size_option /O1)
    elseif(CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang")
        set(_size_option -Os)
    else()
        return()
    endif()
    foreach(_source IN LISTS ARGN)
        if(_source MATCHES "\\.cpp$")
            set_property(SOURCE "${_source}" APPEND PROPERTY COMPILE_OPTIONS
                "$<$<CONFIG:Release,MinSizeRel>:${_size_option}>")
        endif()
    endforeach()
endfunction()
